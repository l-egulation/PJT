  "pendingDecisions": [
    "유료 색상 변경의 빈칸 처리와 무색 칸 변경 범위",
    "사망·런 종료 시 강화와 재고의 초기화 범위",
    "장착 중인 잉크의 직접 판매 허용 여부"
  ],
  "notes": [
    "고정 등급은 파츠의 희소성과 상호작용 가치에 따른 시험 기준이며 같은 파츠의 1~4등급 변형을 만들지 않는다.",
    "색상과 효과 값은 독립이다. 등급 4가 모든 상황에서 등급 1보다 우월한 것을 보장하지 않는다.",
    "중복 가능은 장착 기준이다. 중복 장착 불가 파츠도 재드롭한다.",
    "색상 가중치는 선택된 등급 풀 안의 파츠에 적용한다. 팔레트의 같은 색 칸이 여러 개라도 가중치를 반복 곱하지 않는다.",
    "첫 팔레트의 색상과 보유 잉크가 맞지 않을 수 있다. 첫 팔레트 색상 보정·무료 재추첨은 추가하지 않았다.",
    "표의 내부 쿨타임과 공통 안전 상한은 시험 기준이다. 확정된 표식·추가타 트리거 규칙을 바꾼다는 뜻이 아니다."
  ],
  "compositionRules": {
    "status": "accepted_test_baseline_implementation_pending",
    "sameAttackBonuses": "add_percent_bonuses_then_consume_all_at_attack_start",
    "duplicateMovementBuffs": "independent_instances_sum_up_to_cap",
    "commonAttackGrowth": "multiply_baseline_by_one_plus_additive_character_bonus",
    "chainDepthDefinition": "primary_hit_depth_zero; child_damage_depth_parent_plus_one; limit_only_new_child_damage; resolve_hit_and_kill_rewards_of_accepted_damage",
    "icdReservation": "reserve_before_enqueuing_descendant_events"
  },
  "paletteWeaponBinding": "first_equipped_weapon_no_transfer",
  "basicReferencePolicy": "mean_basic_combo_hit"
}
