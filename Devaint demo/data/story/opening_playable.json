{
  "schemaVersion": 1,
  "id": "opening_playable",
  "title": "색이 있던 마을",
  "status": "draft-pending-user-review",
  "source": "docs/design/story/opening/opening-playable.md",
  "coordinates": "world x in starting-village units (data/assets/starting_hub.json layoutProposal, width 84)",
  "schema": {
    "triggers": {
      "start": "opening begins (new profile or resumed checkpoint)",
      "after": "the named beat finished all its actions",
      "reachX": "player x crosses lte/gte; grounded: also standing; minY/maxY: feet height above the ground",
      "inputDone": "player performed action: move(distance) | jump | airJump | dash | attack1 | attack2 | skill1 | skill2",
      "interact": "player completed F interaction with target",
      "screenClosed": "the named hub screen closed with its goal met",
      "touch": "player touched the named object",
      "wait": "seconds elapsed since the action started (banner doneWhen only)",
      "event": "named runtime event (erasureMet, runDeathReturn, bossFirstClearReturn, firstUnlockColored)",
      "skip": "never fires by itself: the opening's skip (skip.beat) starts the beat"
    },
    "actions": {
      "bubble": "speaker, text, mode auto (no input lock) | advance (F/Space)",
      "banner": "keys, text, doneWhen trigger; the beat waits until done",
      "lockInput / unlockInput": "via the hub control scope, never Time.timeScale",
      "village": "color state allColor | allSketch | profile; interactables hidden | shown",
      "autoWalk": "teleport to fromX, then walk to toX",
      "erasureChase": "fromBehind (units left of the hero), holdAt (the front waits there until released), slowFromX (slower past it while held); the left front appears still and the hero turns to it",
      "erasureGo / erasureRelease": "start the front / drop its hold and chase after seconds of grace (tuning in the chase block)",
      "waitErasure": "hold the beat until the left front reaches x",
      "heroSketch": "mode hands: the hero turns to sketch where it stands, softly from both hands (non-blocking; waitAnimation holds until it has covered the body) | revive: the helper's ink floods the sketch from the chest, then drains into the face as the colour comes back (the ink body)",
      "waitAnimation": "hold the beat until the stage's animations (hero sketch, helper gathering until its pop, helper leap until it lands) are done",
      "erasureClose / erasureMeet": "a right front comes in rightAhead units right of the hero, both drifting at rightSpeed/leftSpeed / both reach the hero within seconds (event erasureMet)",
      "cameraShake / sfx / wait": "presentation",
      "drainColor": "actor colour drains to sketch over seconds",
      "clip": "actor, clip, x, reverse (helper clip leap: it jumps into the hero's chest; the beat waits until it lands. hero clip inkGather: the hero lies at x as a shape of gathering ink and its colour comes back; death reversed gets it up)",
      "actor": "spawn | despawn a story actor (the helper gathers out of streaks of light from its pixel sheet; the beat waits until it pops)",
      "checkpoint": "persist openingCheckpoint",
      "flag": "persist a profile flag",
      "awaken": "the opening's road, erasure and helper go; every movement opens; the hero stays the ink body",
      "openStation": "id, doneWhen; opens that station's screen as the F key would",
      "lesson": "keys, text, ghost: the game pauses while the recorded ghost (data/story/opening_ghosts.json) shows the move with its keys lit as it presses them; Space closes it once the ghost has shown it (that Space does not jump). Without ghost: a guide card.",
      "abilities": "set: exactly these movements are usable (jump | airJump | wall | dash; [] = walking only) | grant: add them. Untaught movement stays locked; the end of the opening opens everything",
      "notebook": "the investigator's notebook (notebook block) over a dark screen; Space turns the pages; the beat waits until it is closed",
      "broom": "mode appear: the village broom (broom block) stands at x, still | fight: it walks at the hero and strikes; the beat waits until it falls",
      "inkFlicker": "the hero's ink flickers for a moment (running short)",
      "face": "face 1 | -1: the hero turns",
      "mark": "id: an F keycap stays over that station until the next mark (empty id clears)",
      "focus": "x: the camera eases onto x as if the hero stood there | heroOffset: that far right of the hero | neither: back on the hero",
      "zoom": "zoom: the camera closes in about the hero (halfway to the helper once it is out), 1 = the usual view",
      "exclaim": "a 「!」 pops over the artisan's head (it notices the hero)",
      "pigment": "the village's magic pigment chip appears for the first time",
      "controls": "mode show: small cards at the top, each playing its recorded ghost (items: ghost, keys, text) with the keys and name under the picture, while the game goes on; F closes them | hide",
      "demo": "mode play: the recorded ghost (data/story/opening_ghosts.json) plays its move over and over where it was recorded, keys and text over it, the game going on | clear: every demonstration goes"
    },
    "course": "road left of the village (negative x) used only by the opening: walls are moss blocks (climbable when taller than the hero; a bottom makes one hang), fences and crates are solid wooden props, platforms are one-way stone tiles, residents stand by it. The ground runs from leftX; the camera stops at cameraLeftX so the hero walks in from off screen. dodgeGate: a solid wall whose bottom opens only after the player dashes invulnerably through a practice shot; intentional opening skip also releases it.",
    "chase": "the left front's average speed by the hero's x (speeds) times a repeating surge pattern; leash pulls it faster when the hero is more than far units ahead (k per unit, at most max); it stops for bite.hold seconds when it swallows an object, then shakes the screen (bite.shake seconds, bite.amp px); ground turns groundLead units ahead of it, each object objectLagMin..objectLagMax behind; slow is the rate while it covers the residents; a catch (catchMargin, or a chase pit) restarts at checkpointX with the front checkpointBack behind"
  },
