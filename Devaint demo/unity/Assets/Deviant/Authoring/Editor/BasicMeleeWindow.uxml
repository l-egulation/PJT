<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="LocomotionWindow.uss" />
    <ui:ScrollView class="locomotion-editor">
        <ui:Label text="근접 기본 16타 수치 편집" class="heading" />
        <ui:Label text="기존 7형태 17타 중 검 1타는 전용 창을 유지합니다. 이 창은 나머지 16타의 기존 원본 배열을 편집하며 특수·원거리·프레임·아트를 변경하지 않습니다." class="description" />
        <ui:Label name="source" class="description" />
        <ui:DropdownField name="hit" label="형태 / 타격" />
        <ui:Button name="firstSword" text="검 1타 전용 창 열기" />
        <uie:ObjectField name="runtime" label="적용할 전투" />
        <ui:FloatField name="damage" label="기준 피해" />
        <ui:FloatField name="duration" label="모션 길이 (s)" />
        <ui:FloatField name="impact" label="타격 시각 (s)" />
        <ui:FloatField name="active" label="형태 공통 판정 활성 (s)" />
        <ui:Label name="sharedActive" class="description" />
        <ui:FloatField name="width" label="박스 너비 (unit)" />
        <ui:FloatField name="height" label="박스 높이 (unit)" />
        <ui:FloatField name="offsetX" label="오른쪽 X 오프셋 (unit)" />
        <ui:FloatField name="offsetY" label="Y 오프셋 (unit)" />
        <ui:Label name="diff" class="description" />
        <ui:VisualElement name="geometryPreview" />
        <ui:VisualElement class="actions">
            <ui:Button name="applyNext" text="전체 후보 다음 시작부터 적용" />
            <ui:Button name="applyReset" text="전체 후보 리셋 후 적용" />
            <ui:Button name="reload" text="원본 재로드 (전체 편집 폐기)" />
        </ui:VisualElement>
        <ui:TextField name="python" label="Python 실행 파일" />
        <ui:Button name="save" text="전체 후보 원본 저장 · 문서/카탈로그 재생성" />
        <ui:Label name="state" class="description" />
        <ui:Label name="status" class="description" />
        <ui:Label text="선택을 바꿔도 다른 타격의 편집값을 보존합니다. 전체 후보 중 하나라도 무효면 적용·저장을 모두 거부합니다. 진행 중 공격은 시작 버전을 유지합니다. 적용은 원본을 저장하지 않고 저장은 현재 전투에 적용하지 않습니다. 저장 후 생성 실패는 저장한 원본을 보존하며 같은 버튼으로 재생성할 수 있습니다. Undo는 편집값만 되돌리고 파일 해시·저장·전투 리셋은 되돌리지 않습니다." class="description" />
    </ui:ScrollView>
</ui:UXML>
