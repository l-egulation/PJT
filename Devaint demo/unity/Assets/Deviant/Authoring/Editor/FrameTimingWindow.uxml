<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="LocomotionWindow.uss" />
    <ui:ScrollView class="locomotion-editor">
        <ui:Label text="프레임 기준 시간 · 원본/임시 적용" class="heading" />
        <ui:Label text="고정 원본은 현재 해석된 실제 시간을 보존해 FrameTime 후보로 가져옵니다. FrameTime 원본은 저장된 프레임/마커를 읽습니다. 스텝 앵커는 앞 프레임 변경을 따라가며 아래 diff를 확인한 뒤 명시적으로 원본에 저장합니다." class="description" />
        <ui:Label name="source" class="description" />
        <uie:ObjectField name="runtime" label="적용할 전투" />
        <ui:Button name="reload" text="현재 원본에서 다시 가져오기 (편집 폐기)" />
        <ui:VisualElement class="actions">
            <ui:Button name="importPreset" text="프레임 실험 파일 불러오기" />
            <ui:Button name="exportPreset" text="프레임 실험 파일 저장" />
        </ui:VisualElement>
        <ui:Label name="preset" class="description" />
        <ui:VisualElement name="geometryPreview" />
        <ui:VisualElement name="frames" />
        <ui:VisualElement name="markers" />
        <ui:VisualElement class="actions">
            <ui:Button name="applyNext" text="다음 1타부터 임시 적용" />
            <ui:Button name="applyReset" text="리셋 후 임시 적용" />
            <ui:Button name="restoreFixed" text="다음 1타부터 고정 실행 복귀" />
        </ui:VisualElement>
        <ui:TextField name="python" label="Python 실행 파일" />
        <ui:Button name="saveSource" text="FrameTime 원본 저장 · 카탈로그 재생성 (명시적 모드 전환)" />
        <ui:Label name="result" class="description" />
        <ui:Label name="state" class="description" />
        <ui:Label name="status" class="description" />
        <ui:Label text="접촉·활성 종료·행동 종료·Cue 시작은 한 프레임 시간표가 소유합니다. 임시 적용과 실험 파일 저장은 게임용 원본을 바꾸지 않습니다. FrameTime 원본 저장은 기존 고정 매체/아트 바인딩을 읽기 전용으로 보존하며 새 Play 세션부터 생성된 원본을 사용합니다. 현재 전투 적용은 별도이며 진행 중 실행은 시작 버전을 유지합니다. 원본을 두 개 만들거나 공유 아트를 편집하지 않습니다. 고정 실행 복귀는 현재 전투의 임시 선택이며 영구 역변환은 제공하지 않습니다." class="description" />
    </ui:ScrollView>
</ui:UXML>
