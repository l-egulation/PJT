# Project-specific feedback bindings are generated from the retained vendor assets.
/unity/Assets/Deviant/Presentation/Resources/HitFeedback/Generated/
/unity/Assets/Deviant/Presentation/Resources/HitFeedback/Generated.meta

# Standalone local playtest builds are not game sources.
/Playtest/InkForest-Hwang-Windows/
/unity/Assets/ForestCombatV2/Resources/ClockBossEnvironment/*.bytes

# Boss PNG TextAsset and embedded-media editor bundles are restored from resources.
/unity/Assets/ForestCombatV2/Resources/ClockExecutioner/StationaryBytes.bytes
/tools/chapter1-map-editor/맵 편집기.html
/tools/chapter1-map-editor/이전_지형용_편집기.html

# Source media live in resources; restored using the deployment manifest.
/unity/Assets/Chapter2/Resources/RoseBlue/*.bytes

/unity/Assets/Deviant/Game/Resources/NotebookOpening/*.png

# Encoded Opus payloads are restored from the pinned compressed-media resource selection.
/unity/Assets/Deviant/Media/Resources/CompressedAudio/Payloads/*.bytes

# Temporary source-clip relocation during player packaging.
/unity/Assets/Deviant/Media/ExcludedAudioBuild/
/unity/Assets/Deviant/Media/ExcludedAudioBuild.meta

# Approved theme media restored from pinned resources.
/unity/Assets/Deviant/UI/Theme/Resources/ApprovedTheme/sources/**/*.png
/unity/Assets/Deviant/UI/Fonts/Resources/ApprovedTheme/Fonts/*.ttf

# Recovered map icon media restored from the pinned resource selection.
/unity/Assets/Deviant/UI/Theme/Resources/RecoveredMapIcons/*.png
