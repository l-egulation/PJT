#!/usr/bin/env bash
set -euo pipefail

[[ $# == 4 ]] || { echo "usage: k3s-image-build IMAGE_NAME IMAGE_TAG DOCKERFILE CONTEXT" >&2; exit 2; }
image_name="$1"
image_tag="$2"
dockerfile="$3"
context="$4"
[[ "$image_name" == game-api || "$image_name" == web || "$image_name" == admin-console || "$image_name" == event-consumers ]] || { echo "invalid image name" >&2; exit 2; }
[[ "$image_tag" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ && "$image_tag" != latest && "$image_tag" != bootstrap ]] || { echo "invalid image tag" >&2; exit 2; }
[[ "$dockerfile" == "$context"/* && -f "$dockerfile" && -d "$context" ]] || { echo "Dockerfile must be inside the build context" >&2; exit 2; }

image="docker.io/hanjjak/$image_name:$image_tag"
export BUILDKIT_HOST=unix:///run/buildkit-k3s.io/buildkitd.sock
exec nerdctl \
  --address /run/k3s/containerd/containerd.sock \
  --namespace k8s.io \
  --snapshotter overlayfs \
  build --pull \
  --label "org.opencontainers.image.revision=$image_tag" \
  --file "$dockerfile" \
  --tag "$image" \
  "$context"
