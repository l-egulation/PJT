# Copy to .env. Supply a private administrator token; never put it in the game build.
ADMIN_TOKEN=
# Exact origin(s) of Web builds. Comma-separated, no trailing slash or path.
CORS_ORIGINS=http://localhost:8081
BIND_ADDRESS=127.0.0.1
PORT=8080
MAX_STORAGE_BYTES=2147483648
PLAYER_DAILY_BYTES=67108864
RETENTION_DAYS=30

# Optional: Cloudflare remotely-managed Tunnel connector token (server only).
# Required only with: docker compose --profile tunnel up -d --build
# Dashboard published application Service URL: http://collector:8080
CLOUDFLARE_TUNNEL_TOKEN=
